# Copy to .env and fill in values.

# ── Database (shared with the Go backend during migration) ───────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_management

# ── Go backend API ────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8080/api/v1

# ── Clerk ─────────────────────────────────────────────────────────────────────
# From Clerk Dashboard -> API Keys (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: custom paths (defaults match the sign-in/sign-up pages added)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
